{
    "name": "@tally/client",
    "main": "expo-router/entry",
    "version": "0.1.0",
    "dependencies": {
        "@react-native-async-storage/async-storage": "2.2.0",
        "@tally/core": "workspace:*",
        "expo": "~57.0.15",
        "expo-clipboard": "~57.0.1",
        "expo-constants": "~57.0.13",
        "expo-crypto": "~57.0.1",
        "expo-linking": "~57.0.7",
        "expo-network": "~57.0.1",
        "expo-router": "~57.0.15",
        "expo-secure-store": "~57.0.1",
        "expo-splash-screen": "~57.0.7",
        "expo-status-bar": "~57.0.1",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.2",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-web": "~0.21.0",
        "socket.io-client": "^4.8.3"
    },
    "devDependencies": {
        "@types/react": "~19.2.2",
        "cypress": "^13.17.0",
        "eslint": "^9.0.0",
        "eslint-config-expo": "~57.0.1",
        "typescript": "~6.0.3",
        "vitest": "4.1.9"
    },
    "scripts": {
        "start": "expo start",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "build": "expo export --platform web",
        "test:e2e": "TS_NODE_PROJECT=tsconfig.cypress.json cypress run",
        "test:unit": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write src/ tests/e2e/ app.config.js app.json cypress.config.mjs eslint.config.js package.json tsconfig.json tsconfig.cypress.json",
        "format:check": "prettier --check src/ tests/e2e/ app.config.js app.json cypress.config.mjs eslint.config.js package.json tsconfig.json tsconfig.cypress.json",
        "lint": "expo lint",
        "lint:all": "bun typecheck && bun format:check && bun lint"
    },
    "private": true
}
