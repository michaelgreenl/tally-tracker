{
    "expo": {
        "name": "Tally",
        "slug": "tally-tracker",
        "version": "0.1.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "tally",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "com.tallytracker.app",
            "appleTeamId": "JS8H2Z53Y9",
            "usesAppleSignIn": true,
            "icon": "./assets/tally.icon"
        },
        "android": {
            "package": "com.tallytracker.app",
            "permissions": ["android.permission.VIBRATE"],
            "adaptiveIcon": {
                "backgroundColor": "#0f7899",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "monochromeImage": "./assets/images/android-icon-foreground.png"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            [
                "expo-router",
                {
                    "origin": "https://michaelgreenl.github.io/tally-tracker"
                }
            ],
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#17191c",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 120
                }
            ],
            "expo-secure-store",
            "expo-apple-authentication",
            "@sentry/react-native/expo"
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
