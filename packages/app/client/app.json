{
    "expo": {
        "name": "Tally",
        "slug": "tally-tracker",
        "version": "1.1.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "tally",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "com.tallytracker.app",
            "buildNumber": "5",
            "appleTeamId": "JS8H2Z53Y9",
            "usesAppleSignIn": true,
            "icon": "./assets/tally.icon"
        },
        "android": {
            "package": "com.tallytracker.app",
            "permissions": ["android.permission.VIBRATE"],
            "adaptiveIcon": {
                "backgroundColor": "#0f7899",
                "foregroundImage": "./assets/images/android-icon-foreground.png",
                "monochromeImage": "./assets/images/android-icon-foreground.png"
            },
            "predictiveBackGestureEnabled": false
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            [
                "expo-build-properties",
                {
                    "ios": {
                        "enableSceneSupport": true
                    }
                }
            ],
            [
                "expo-router",
                {
                    "origin": "https://michaelgreenl.github.io/tally-tracker"
                }
            ],
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#17191c",
                    "image": "./assets/images/splash-icon.png",
                    "imageWidth": 120
                }
            ],
            [
                "expo-font",
                {
                    "ios": {
                        "fonts": [
                            "./assets/fonts/Quicksand-Regular.ttf",
                            "./assets/fonts/Quicksand-Medium.ttf",
                            "./assets/fonts/Quicksand-SemiBold.ttf",
                            "./assets/fonts/Quicksand-Bold.ttf"
                        ]
                    },
                    "android": {
                        "fonts": [
                            {
                                "fontFamily": "Quicksand",
                                "fontDefinitions": [
                                    { "path": "./assets/fonts/Quicksand-Regular.ttf", "weight": 400 },
                                    { "path": "./assets/fonts/Quicksand-Medium.ttf", "weight": 500 },
                                    { "path": "./assets/fonts/Quicksand-SemiBold.ttf", "weight": 600 },
                                    { "path": "./assets/fonts/Quicksand-Bold.ttf", "weight": 700 }
                                ]
                            }
                        ]
                    }
                }
            ],
            "expo-secure-store",
            "expo-apple-authentication",
            [
                "@sentry/react-native/expo",
                {
                    "organization": "mgsentrypersonal",
                    "project": "tally-client"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true
        }
    }
}
