# Use the deployed API for physical-device development.
# Web development proxies requests to this API through the Expo server.
# Restart Expo after changing this URL.
EXPO_PUBLIC_API_URL=https://tally-tracker-server.onrender.com

# Sentry stays disabled until both values are configured.
EXPO_PUBLIC_SENTRY_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_DIST=
