# Use the deployed API for physical-device development.
# Web development proxies requests to this API through the Expo server.
# Restart Expo after changing this URL.
EXPO_PUBLIC_API_URL=https://tally-tracker-server.onrender.com

# Public Google OAuth client IDs. Never add a client secret to the app.
# The iOS value must match this bundle ID: com.tallytracker.app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Public SDK keys only. Test Store is used only in development builds.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
# Keep release keys empty until real store billing is ready.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Sentry stays disabled until both values are configured.
EXPO_PUBLIC_SENTRY_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
EXPO_PUBLIC_SENTRY_RELEASE=
EXPO_PUBLIC_SENTRY_DIST=
