NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8081
POSTGRES_URL=postgresql://template_user:template_pass@localhost:5432/template_db
JWT_SECRET=replace-with-a-random-secret
EMAIL_OTP_SECRET=replace-with-a-different-random-secret
RESEND_API_KEY=
EMAIL_FROM=Tally <noreply@example.com>

# Server-only RevenueCat v1 secret key. Never use an EXPO_PUBLIC_ variable for this key.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
# At least 32 random characters. Configure the webhook header as "Bearer <secret>".
REVENUECAT_WEBHOOK_SECRET=
# Enable only on the test backend. Keep false for the public release backend.
REVENUECAT_ALLOW_SANDBOX=false
