NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8081
# Same Web application client ID used by the app. No client secret is needed.
GOOGLE_WEB_CLIENT_ID=
# Configure all five values together. The native client ID is com.tallytracker.app.
# Keep the .p8 key and encryption key on the server only.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 contents; escaped \n line breaks are supported.
APPLE_PRIVATE_KEY=
# Generate 32 random bytes as 64 hex characters. Keep this stable across signing-key rotation.
APPLE_TOKEN_ENCRYPTION_KEY=
POSTGRES_URL=postgresql://template_user:template_pass@localhost:5432/template_db
# Production requires separate random secrets, each at least 32 characters.
JWT_SECRET=replace-with-a-random-secret
EMAIL_OTP_SECRET=replace-with-a-different-random-secret
# Production also requires HTTPS FRONTEND_URL and a configured email sender.
RESEND_API_KEY=
EMAIL_FROM=Tally <noreply@example.com>

# Server-only RevenueCat v1 secret key. Never use an EXPO_PUBLIC_ variable for this key.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=premium
# At least 32 random characters. Configure the webhook header as "Bearer <secret>".
REVENUECAT_WEBHOOK_SECRET=
# Enable only on the test backend. Keep false for the public release backend.
REVENUECAT_ALLOW_SANDBOX=false
