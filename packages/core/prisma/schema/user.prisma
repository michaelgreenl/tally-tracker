enum UserTier {
    PREMIUM
    BASIC
}

model User {
    id               String    @id @default(uuid()) @db.Uuid
    email            String    @unique
    password         String?
    googleSubject    String?   @unique @map("google_subject")
    tier             UserTier  @default(BASIC)
    emailVerifiedAt  DateTime? @map("email_verified_at")
    sessionVersion   Int       @default(0) @map("session_version")
    premiumExpiresAt DateTime? @map("premium_expires_at")
    billingCheckedAt DateTime? @map("billing_checked_at")
    billingSandbox   Boolean   @default(false) @map("billing_sandbox")

    counters       Counter[]      @relation("OwnedCounters")
    sharedCounters CounterShare[] @relation("ReceivedShares")
    refreshTokens  RefreshToken[] @relation("RefreshTokens")
    emailOtps      EmailOtp[]     @relation("EmailOtps")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("users")
}
