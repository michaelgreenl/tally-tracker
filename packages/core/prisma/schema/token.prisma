model RefreshToken {
    id     String @id @default(uuid())
    userId String @map("user_id") @db.Uuid
    user   User   @relation("RefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

    expiresAt DateTime @map("expires_at")
    createdAt DateTime @default(now()) @map("created_at")
    rotatedAt DateTime? @map("rotated_at")
    replacementId String? @map("replacement_id")

    @@map("refresh_tokens")
}

enum EmailOtpPurpose {
    EMAIL_VERIFICATION
    PASSWORD_RESET
}

model EmailOtp {
    id       String          @id @default(uuid()) @db.Uuid
    userId   String          @map("user_id") @db.Uuid
    user     User            @relation("EmailOtps", fields: [userId], references: [id], onDelete: Cascade)
    purpose  EmailOtpPurpose
    digest   String
    attempts Int             @default(0)

    expiresAt DateTime @map("expires_at")
    consumedAt DateTime? @map("consumed_at")
    createdAt DateTime @default(now()) @map("created_at")

    @@unique([userId, purpose])
    @@index([expiresAt])
    @@map("email_otps")
}

model LoginRateLimit {
    key     String   @id
    hits    Int
    resetAt DateTime @map("reset_at") @db.Timestamptz(3)

    @@index([resetAt])
    @@map("login_rate_limits")
}
